config SHIELD_CORNE_LEFT
    def_bool $(shields_list_contains,corne_left)

config SHIELD_CORNE_DONGLE
    def_bool $(shields_list_contains,corne_dongle)

config SHIELD_CORNE_RIGHT
    def_bool $(shields_list_contains,corne_right)

config SHIELD_CORNE_RIGHT832
    def_bool $(shields_list_contains,corne_right832)

config SHIELD_CORNE_RIGHT_M
    def_bool $(shields_list_contains,corne_right_m)
    
config EEPROM_WEAR_LEVELING
    bool "Enable EEPROM wear leveling"
    default y
    help
      Enable wear leveling for EEPROM-like storage.
config ZMK_QF_595
    bool "Enable my 595"
    default n